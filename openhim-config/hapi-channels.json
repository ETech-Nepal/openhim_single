[
  {
    "name": "NP FHIR read",
    "type": "http",
    "status": "enabled",
    "authType": "private",
    "requestBody": true,
    "responseBody": true,
    "priority": 2,
    "allow": [
      "hospital",
      "laboratory"
    ],
    "routes": [
      {
        "name": "HAPI FHIR",
        "host": "fhir",
        "port": 8080,
        "primary": true,
        "type": "http",
        "secured": false,
        "forwardAuthHeader": true
      }
    ],
    "properties": [],
    "txViewAcl": [],
    "txViewFullAcl": [],
    "methods": [
      "GET",
      "HEAD"
    ],
    "description": "Reads and searches, straight to HAPI. The HAPI access rules check the token's scopes and refuse searches that do not name one patient.",
    "urlPattern": "^/fhir(/metadata|/[A-Z][A-Za-z]+(/[^/]+)?(/_history(/[^/]+)?)?)?/?$"
  },
  {
    "name": "NP FHIR write",
    "type": "http",
    "status": "enabled",
    "authType": "private",
    "requestBody": true,
    "responseBody": true,
    "priority": 2,
    "allow": [
      "hospital",
      "laboratory"
    ],
    "routes": [
      {
        "name": "HAPI FHIR",
        "host": "fhir",
        "port": 8080,
        "primary": true,
        "type": "http",
        "secured": false,
        "forwardAuthHeader": true
      }
    ],
    "properties": [],
    "txViewAcl": [],
    "txViewFullAcl": [],
    "methods": [
      "POST",
      "PUT"
    ],
    "description": "Single-resource writes, straight to HAPI. Patient writes (identity mediator) and Bundles (transform mediator) match their priority-1 channels first.",
    "urlPattern": "^/fhir/[A-Z][A-Za-z]+(/[^/]+)?$"
  }
]
