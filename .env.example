# Local defaults. Set DOMAIN and replace both Keycloak URLs before using the vps profile.
DOMAIN=
VPS_IP=
KEYCLOAK_PUBLIC_URL=http://localhost:8083
KEYCLOAK_ISSUER=http://localhost:8083/realms/openhie
# Where openhim-core fetches signing keys. Default reaches the bundled Keycloak over the
# compose network. For an external realm set it to <issuer>/protocol/openid-connect/certs.
KEYCLOAK_JWKS_URI=http://keycloak:8080/realms/openhie/protocol/openid-connect/certs
# URL clients use to call OpenHIM. DPoP proofs must name it (htu). vps: https://openhim.<DOMAIN>
PUBLIC_BASE_URL=https://localhost:5000

# Required secrets (no defaults). Generate each with: openssl rand -base64 32
HAPI_DB_PASSWORD=
KEYCLOAK_DB_PASSWORD=
KEYCLOAK_ADMIN_PASSWORD=
IDENTITY_DB_PASSWORD=
OPENHIM_SESSION_KEY=

# Tag (commit SHA) of the images built from the openhie repository:
# openhie-hapi, openhie-identity-mediator, fhir-transform-mediator,
# openhie-patient-portal-mediator.
OPENHIE_IMAGE_TAG=74c064e72afd15fbc62f834ca44a1669c47776d7
