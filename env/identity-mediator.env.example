# Mediator
MEDIATOR_PORT=4002
MEDIATOR_URN=urn:mediator:np-identity
NODE_ENV=production
MEDIATOR_ROUTE_HOST=identity-mediator

# OpenHIM Core API: limited user with role mediator-registration, not root.
OPENHIM_API_URL=https://openhim-core:8080
OPENHIM_USERNAME=mediators@openhim.local
OPENHIM_PASSWORD=
OPENHIM_TRUST_SELF_SIGNED=true
OPENHIM_PATIENT_ROLES=hospital,laboratory
OPENHIM_ADMIN_ROLE=np-admin-clients

# Client tokens forwarded by OpenHIM are verified against the realm.
# KEYCLOAK_ISSUER comes from the root .env (compose sets it).
KEYCLOAK_JWKS_URI=http://keycloak:8080/realms/openhie/protocol/openid-connect/certs
ADMIN_CLIENT_IDS=admin-portal

# This mediator's own client for its HAPI writes (private_key_jwt + DPoP).
KEYCLOAK_TOKEN_URL=http://keycloak:8080/realms/openhie/protocol/openid-connect/token
IDENTITY_CLIENT_ID=identity-mediator
IDENTITY_CLIENT_KEY_PATH=/run/secrets/identity-mediator.key.pem

# HAPI FHIR
HAPI_FHIR_BASE_URL=http://fhir:8080/fhir
HAPI_TIMEOUT_MS=15000

# JeMPI over the WireGuard tunnel
JEMPI_BASE_URL=http://10.60.0.2:50000/JeMPI
JEMPI_TIMEOUT_MS=15000

# Identity database (role and database created by hapi-db/init/10-roles.sh)
IDENTITY_DB_HOST=hapi-db
IDENTITY_DB_PORT=5432
IDENTITY_DB_USER=identity
# IDENTITY_DB_PASSWORD comes from the root .env (compose sets it).
IDENTITY_DB_NAME=identity

# Duplicate review: scoring and the hold band.
SCORING_CONFIG_PATH=/config/config-reference-link-dp.json
REVIEW_LOW_THRESHOLD=0.65
REVIEW_HIGH_THRESHOLD=0.75
PLACEHOLDER_PHONES=9800000000,0000000000,9999999999
EXACT_MATCH_FIELDS=dob,national_id,phone_number
DISCRIMINATING_FIELDS=dob,national_id,phone_number
SCAN_ON_BOOT=false
SCAN_PAGE_SIZE=50
