# Patient-portal mediator (read-only aggregate view)
MEDIATOR_PORT=4001
MEDIATOR_URN=urn:mediator:patient-portal
NODE_ENV=production
# Host OpenHIM uses to reach this mediator (compose service name).
MEDIATOR_ROUTE_HOST=patient-portal-mediator

# OpenHIM Core API — Docker-internal service name on the `openhim` network.
OPENHIM_API_URL=https://openhim-core:8080
OPENHIM_USERNAME=root@openhim.org
OPENHIM_PASSWORD=admin
OPENHIM_TRUST_SELF_SIGNED=true
# Role bound to the patient-portal channel; the portal BFF system client holds it.
OPENHIM_PORTAL_CHANNEL_ROLE=patient-portal-clients

# HAPI FHIR — read directly (HAPI is never publicly reachable).
HAPI_FHIR_BASE_URL=http://fhir:8080/fhir
HAPI_TIMEOUT_MS=15000

# ── Verify the forwarded X-Patient-Token ─────────────────────────────────────
# Dev path: HS256, shared with the BFF's SESSION_JWT_SECRET (must match exactly).
# Leave PORTAL_PATIENT_JWKS_URL unset to use this.
PORTAL_PATIENT_SHARED_SECRET=change-me-same-as-bff-SESSION_JWT_SECRET
PORTAL_PATIENT_TOKEN_ISSUER=nepal-patient-portal
PORTAL_GID_CLAIM=gid
# Production: verify Keycloak RS256 tokens via JWKS instead (then drop the secret).
# PORTAL_PATIENT_JWKS_URL=https://keycloak:8443/realms/openhie/protocol/openid-connect/certs
