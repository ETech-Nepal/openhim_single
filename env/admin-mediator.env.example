# Mediator
MEDIATOR_PORT=4002
MEDIATOR_URN=urn:mediator:patient-admin-review
NODE_ENV=production
MEDIATOR_ROUTE_HOST=admin-mediator

# OpenHIM Core API — Docker-internal service name on the `openhim` network.
OPENHIM_API_URL=https://openhim-core:8080
OPENHIM_USERNAME=root@openhim.org
OPENHIM_PASSWORD=admin
OPENHIM_TRUST_SELF_SIGNED=true
OPENHIM_CHANNEL_ROLE=np-admin-clients

# HAPI FHIR
HAPI_FHIR_BASE_URL=http://fhir:8080/fhir
HAPI_TIMEOUT_MS=15000

# JeMPI (over WireGuard tunnel)
JEMPI_BASE_URL=http://202.51.71.81:50000/JeMPI
JEMPI_TIMEOUT_MS=15000

# Review queue database (Postgres — the hapi-db container, separate database)
REVIEW_DB_HOST=hapi-db
REVIEW_DB_PORT=5432
REVIEW_DB_USER=admin
REVIEW_DB_PASSWORD=admin
REVIEW_DB_NAME=admin_review

# Scoring config — the SAME file JeMPI links with, so our m/u weights stay in sync.
SCORING_CONFIG_PATH=/config/config-reference-link-dp.json

# Hold band. Pairs scoring >= REVIEW_LOW are queued for an admin.
# REVIEW_HIGH only labels the band ('likely' vs 'possible') — nothing auto-merges.
REVIEW_LOW_THRESHOLD=0.65
REVIEW_HIGH_THRESHOLD=0.75

# Phone values that are placeholders rather than real numbers. Treated as blank
# when scoring: a shared placeholder must never count as a phone agreement
# (phone's match weight is ~21 bits, so it would swamp every other field).
PLACEHOLDER_PHONES=9800000000,0000000000,9999999999

# Fields compared with EXACT equality instead of the JeMPI config's Jaro-Winkler.
# JW on a date or an ID number is semantically wrong and dangerous: dob 19900101 vs
# 19900102 scores JW 0.95 (>= the 0.92 agreement level) and would count as a FULL
# +14-bit agreement, so siblings/twins look like a near-certain duplicate. We ship
# merge WITHOUT split, so a wrong merge is irreversible — hence the stricter rule.
EXACT_MATCH_FIELDS=dob,national_id,phone_number

# A pair must agree on at least ONE of these to reach the queue. These are the fields
# rare enough to identify a person (low `u`: dob 4.65e-05, phone 4e-07, nid 2e-07).
# Name/city/gender are common (u 0.003-0.44) — agreeing on those alone just means
# "two people share a common name in a big city", which at population scale is
# thousands of pairs and no evidence at all.
DISCRIMINATING_FIELDS=dob,national_id,phone_number

# Resource types whose subject/patient references get repointed on merge.
MERGE_REFERENCING_TYPES=Encounter,Observation,DocumentReference,Condition,Procedure

# Scanner
SCAN_ON_BOOT=false
SCAN_PAGE_SIZE=50
