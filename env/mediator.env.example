# Mediator
MEDIATOR_PORT=4000
MEDIATOR_URN=urn:mediator:fhir-mpi-orchestrator
NODE_ENV=production
# Host OpenHIM uses to reach this mediator. In Docker (default) it is the compose
# service name `mediator`. If you run the mediator on the host instead, set this to
# host.docker.internal (and add that host-gateway mapping to openhim-core).
MEDIATOR_ROUTE_HOST=mediator

# OpenHIM Core API — Docker-internal service name on the `openhim` network.
OPENHIM_API_URL=https://openhim-core:8080
OPENHIM_USERNAME=root@openhim.org
OPENHIM_PASSWORD=admin
OPENHIM_TRUST_SELF_SIGNED=true

# OpenHIM role to bind to the auto-created channel
OPENHIM_CHANNEL_ROLE=np-fhir-clients

# HAPI FHIR — Docker-internal service name + container port (exposed on host as 8081).
HAPI_FHIR_BASE_URL=http://fhir:8080/fhir
HAPI_TIMEOUT_MS=15000

# JeMPI (over WireGuard tunnel — the container routes to 10.8.0.1 via the host)
JEMPI_BASE_URL=http://202.51.71.81:50000/JeMPI
JEMPI_REGISTER_ROUTE=/crRegister
JEMPI_FIND_ROUTE=/crFind
JEMPI_CANDIDATES_ROUTE=/crCandidates
JEMPI_GOLDEN_GET_ROUTE=/expandedGoldenRecord
JEMPI_TIMEOUT_MS=10000
# Synchronous dedup confidence for crRegister (0..1). 0.9 = only link to an
# existing golden record on a high-confidence match; else create a new record.
JEMPI_CANDIDATE_THRESHOLD=0.9
# Fallback facility code when the Patient has no managingOrganization.
JEMPI_DEFAULT_FACILITY=UNKNOWN
