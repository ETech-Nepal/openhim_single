MEDIATOR_PORT=4005
MEDIATOR_URN=urn:mediator:fhir-transform
MEDIATOR_ROUTE_HOST=transform-mediator
CONFIG_DIR=/app/config
FHIR_VALIDATOR_IG=/config/np.core-1.0.0.tgz
VALIDATOR_URL=http://127.0.0.1:8081/validateResource

# Limited OpenHIM user (role mediator-registration), not root. See README.
OPENHIM_API_URL=https://openhim-core:8080
OPENHIM_USERNAME=mediators@openhim.local
OPENHIM_PASSWORD=
OPENHIM_TRUST_SELF_SIGNED=true

# Client tokens forwarded by OpenHIM are verified against the realm.
# KEYCLOAK_ISSUER comes from the root .env (compose sets it).
KEYCLOAK_JWKS_URI=http://keycloak:8080/realms/openhie/protocol/openid-connect/certs

# Where Patients and clinical data go.
IDENTITY_PATIENT_URL=http://identity-mediator:4002/fhir/Patient
HAPI_FHIR_URL=http://fhir:8080/fhir
